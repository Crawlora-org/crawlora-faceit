{
  "name": "@crawlora-org/faceit",
  "version": "0.1.0",
  "description": "Crawlora FACEIT API client with 35 endpoints for leaderboards, players, teams, matches, tournaments, clips, hubs, and public game modes",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=faceit-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-faceit/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "faceit", "faceit-api", "faceit-scraper", "faceit-data", "faceit-leaderboards", "faceit-players", "faceit-teams", "faceit-matches", "faceit-tournaments", "faceit-clips", "faceit-hubs", "faceit-public-game-modes"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-faceit",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
